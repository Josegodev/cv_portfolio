---
interface Props {
  nodes: string[];
  label?: string;
}

const { nodes, label = "Project architecture" } = Astro.props;
---

<figure class="architecture-diagram" aria-label={label}>
  <div class="architecture-flow">
    {nodes.map((node, index) => (
      <>
        <div class="architecture-node">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{node}</strong>
        </div>
        {index < nodes.length - 1 && (
          <div class="architecture-arrow" aria-hidden="true">
            <span></span>
            <b>→</b>
          </div>
        )}
      </>
    ))}
  </div>
  <figcaption>{label}. Simplified public representation.</figcaption>
</figure>
