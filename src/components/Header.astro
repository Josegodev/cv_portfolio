---
import { site } from "../data/site";
import { localizedPath, type Locale } from "../i18n/config";
import { getUi } from "../i18n/ui";
import LanguageSelector from "./LanguageSelector.astro";

interface Props {
  locale: Locale;
  routePath: string;
}

const { locale, routePath } = Astro.props;
const copy = getUi(locale);
const navigation = [
  { label: copy.nav.about, section: "about" },
  { label: copy.nav.experience, section: "experience" },
  { label: copy.nav.projects, section: "projects" },
  { label: copy.nav.stack, section: "stack" },
  { label: copy.nav.education, section: "education" },
  { label: copy.nav.contact, section: "contact" },
];

const pageSection = routePath.includes("/projects/")
  ? "projects"
  : routePath.includes("/cv/")
    ? "experience"
    : undefined;
---

<header class="site-header" data-site-header transition:name="site-header">
  <a class="brand" href={localizedPath(locale)} aria-label={`${site.name}, ${copy.nav.about}`}>
    <span class="brand-mark" aria-hidden="true">{site.shortName}</span>
    <span class="brand-copy">
      <strong>{site.name}</strong>
      <small>{copy.meta.brandLine}</small>
    </span>
  </a>

  <div class="header-actions">
    <nav class="site-nav" id="site-navigation" data-site-nav aria-label={copy.common.primaryNavigation}>
      {navigation.map((item) => (
        <a
          href={localizedPath(locale, `/#${item.section}`)}
          data-nav-link={item.section}
          class:list={{ active: pageSection === item.section }}
          aria-current={pageSection === item.section ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}

      <LanguageSelector locale={locale} routePath={routePath} />

      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label={copy.common.theme}
      >
        <span class="theme-icon" aria-hidden="true">◐</span>
        <span
          data-theme-label
          data-theme-system={copy.common.themeSystem}
          data-theme-dark={copy.common.themeDark}
          data-theme-light={copy.common.themeLight}
        >{copy.common.themeSystem}</span>
      </button>
    </nav>

    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-label={copy.common.openNavigation}
      data-open-label={copy.common.openNavigation}
      data-close-label={copy.common.closeNavigation}
      aria-controls="site-navigation"
      aria-expanded="false"
    >
      <span></span><span></span>
    </button>
  </div>
</header>
