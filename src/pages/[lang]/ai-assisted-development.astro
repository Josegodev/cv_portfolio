---
import { translatedLocales, type Locale } from "../../i18n/config";
import AiAssistedView from "../../views/AiAssistedView.astro";

export function getStaticPaths() {
  return translatedLocales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<AiAssistedView locale={locale} />

