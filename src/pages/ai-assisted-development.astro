---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { withBase } from "../utils/paths";
---

<BaseLayout
  title={`AI-assisted development | ${site.name}`}
  description="Transparent statement about AI assistance used while building and reviewing this portfolio."
>
  <article class="simple-page section-shell">
    <a class="back-link" href={withBase()}><span aria-hidden="true">←</span> Portfolio</a>
    <header data-reveal>
      <p class="eyebrow"><span>Transparency</span> AI-assisted development</p>
      <h1>Assistance is useful. Responsibility stays human.</h1>
      <p class="project-intro">
        Generative AI tools supported implementation, review and documentation. Architecture
        direction, professional content, privacy filtering, validation and publication remain
        human responsibilities.
      </p>
    </header>
    <div class="disclosure-grid">
      <section data-reveal>
        <span>01</span>
        <h2>Where AI helped</h2>
        <p>
          Static page structure, Astro migration, CSS organization, interaction patterns,
          link checks, accessibility review and synthetic example framing.
        </p>
      </section>
      <section data-reveal>
        <span>02</span>
        <h2>What remains human</h2>
        <p>
          Problem selection, professional claims, technical judgment, confidential-data
          filtering, acceptance criteria and the final decision to publish.
        </p>
      </section>
      <section data-reveal>
        <span>03</span>
        <h2>Public boundary</h2>
        <p>
          No real logs, credentials, private corpora, customer data, internal servers or
          controlled company documents are intentionally published.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
