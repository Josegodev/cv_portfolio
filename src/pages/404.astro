---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";
---

<BaseLayout title="Page not found | José González Oliva" description="The requested portfolio page does not exist.">
  <section class="not-found section-shell">
    <p class="eyebrow"><span>404</span> Route not found</p>
    <h1>This path is outside the system map.</h1>
    <p>The page may have moved during the portfolio redesign.</p>
    <a class="button primary" href={withBase()}>Return home</a>
  </section>
</BaseLayout>
